<?xml version="1.0" encoding="UTF-8"?>
<!--
  ESTE ARQUIVO É REFERÊNCIA, NÃO É PRA COPIAR POR CIMA DO SEU.

  É o config.xml que o Tizen Studio gera pro template TV + Web Application,
  que já funciona como está. A casca do Flow não precisa de NENHUMA linha a
  mais: o acesso de rede ao PC já funciona sem <access>, e declarar
  privilege de internet ou features de tela que o perfil tv-samsung não
  conhece só faz o validador recusar o projeto na hora do launch.

  Do app de TV, o único arquivo que você troca é o index.html.

  O `id` e o `package` abaixo são de exemplo: o Tizen Studio gera os seus
  na criação do projeto. Trocar esses valores instala um app SEPARADO na TV
  em vez de atualizar o que já está lá.
-->
<widget xmlns:tizen="http://tizen.org/ns/widgets" xmlns="http://www.w3.org/ns/widgets" id="http://yourdomain/flow" version="0.2.1" viewmodes="maximized">
    <tizen:application id="Pnz6w3CQfO.flow" package="Pnz6w3CQfO" required_version="2.3"/>
    <content src="index.html"/>
    <feature name="http://tizen.org/feature/screen.size.normal.1080.1920"/>
    <icon src="icon.png"/>
    <tizen:metadata key="http://samsung.com/tv/metadata/prelaunch.support" value="true"/>
    <tizen:metadata key="http://tizen.org/metadata/app_ui_type/base_screen_resolution" value="extensive"/>
    <name>flow</name>
    <tizen:privilege name="http://tizen.org/privilege/application.launch"/>
    <tizen:profile name="tv-samsung"/>
    <!-- hwkey-event="enable": faz o botão Return físico chegar como keydown
         (keyCode 10009), que o tv-nav já trata (ver src/lib/tv-nav.ts).

         pointing-device-support="disable": É ISTO que desliga o cursor do
         Smart Remote, não uma metadata (uma tentativa anterior aqui usava
         `tizen:metadata key=".../use.pointer.mode"`, que não existe de
         verdade — tizen:metadata aceita qualquer chave sem validar, então
         nunca deu erro, só nunca fez nada). Documentado em
         https://developer.samsung.com/smarttv/develop/guides/fundamentals/configuring-tv-applications.html:
         em TVs 2015-2020 o padrão é "enable" (é por isso que sem esta linha
         o cursor aparece); em 2021+ já vem "disable" por padrão. Com isto
         desligado, o controle para de mandar coordenadas de ponteiro e passa
         a mandar só teclas — é o que faz o foco "teleportar" de elemento em
         elemento em vez do cursor andar de pixel em pixel, igual no menu de
         configuração nativo da TV. -->
    <tizen:setting screen-orientation="landscape" context-menu="enable" background-support="disable" encryption="disable" install-location="auto" hwkey-event="enable" pointing-device-support="disable"/>
</widget>
