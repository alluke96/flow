# Copie este arquivo para .env.local em desenvolvimento, ou configure estas
# variáveis diretamente no provedor de deploy (Vercel → Project Settings →
# Environment Variables) em produção.
#
# Sem nenhuma delas configurada, o app roda inteiro com o catálogo MOCK
# (ver src/lib/catalog-source/mock.ts) — é assim que ele funciona logo
# depois do deploy, sem exigir nada além disto.

# --- Google Drive (opcional — habilita o catálogo real) --------------------
# JSON completo da chave da Service Account (Google Cloud → IAM → Service
# Accounts → chave em JSON). Pode colar o JSON cru ou, se o provedor de
# deploy lidar mal com newlines/aspas em env vars multi-linha, em base64
# (ex: `base64 -w0 service-account.json`).
GOOGLE_SERVICE_ACCOUNT_KEY=

# ID da pasta raiz do catálogo no Drive (compartilhada com o e-mail da
# service account, permissão de leitura). É o trecho depois de
# /folders/ na URL da pasta no Google Drive.
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# CORS em /api/* é restrito à própria origem automaticamente (compara com o
# Host da própria request, ver src/proxy.ts) — nenhuma variável precisa ser
# configurada pra isso, funciona igual em qualquer endereço que o app seja
# acessado (domínio do Vercel, IP da LAN, hostname .local etc.).

# --- Persistência de perfis ----------------------------------------------
# Pasta onde o servidor grava profiles.json (perfis, watchlist, progresso —
# ver src/lib/profiles-store.ts). Sem login de verdade, perfis vivem num
# arquivo no próprio servidor em vez de por navegador, então qualquer
# dispositivo (TV, celular, PC) enxerga os mesmos.
#
# Em self-host: aponte pra FORA da pasta do checkout do git, senão o deploy
# apaga os perfis a cada push (o pipeline faz um checkout limpo — ver
# deploy-selfhost.yml). Ex: FLOW_DATA_DIR=C:\flow-data
#
# Sem essa variável, cai num "data/" dentro do próprio projeto — ok pra
# rodar localmente, mas some a cada deploy self-host se não for configurada.
# No Vercel isso não persiste de verdade entre deploys/instâncias (disco
# efêmero de serverless) — perfis funcionam durante a sessão mas não são
# garantidos de sobreviver a um redeploy lá.
FLOW_DATA_DIR=
