# Copie este arquivo para .env.local em desenvolvimento, ou configure estas
# variáveis diretamente no provedor de deploy (Vercel → Project Settings →
# Environment Variables) em produção.
#
# Sem nenhuma delas configurada, o app roda inteiro com o catálogo MOCK
# (ver src/lib/catalog-source/mock.ts) — é assim que ele funciona logo
# depois do deploy, sem exigir nada além disto.

# --- Google Drive (opcional — habilita o catálogo real) --------------------
# JSON completo da chave da Service Account (Google Cloud → IAM → Service
# Accounts → chave em JSON). Pode colar o JSON cru ou, se o provedor de
# deploy lidar mal com newlines/aspas em env vars multi-linha, em base64
# (ex: `base64 -w0 service-account.json`).
GOOGLE_SERVICE_ACCOUNT_KEY=

# ID da pasta raiz do catálogo no Drive (compartilhada com o e-mail da
# service account, permissão de leitura). É o trecho depois de
# /folders/ na URL da pasta no Google Drive.
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# --- Segurança ---------------------------------------------------------
# Origem canônica do app em produção — usada pelo middleware pra restringir
# CORS em /api/*. Ex: https://flow.vercel.app
NEXT_PUBLIC_SITE_ORIGIN=
